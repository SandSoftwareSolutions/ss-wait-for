{
  "name": "@sandsoftwaresolutions/wait-for",
  "version": "0.1.1",
  "description": "Wait until a condition, port or URL is ready, with a time limit and an error that says what you were waiting for.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "wait",
    "poll",
    "port",
    "healthcheck",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-wait-for.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-wait-for/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-wait-for#readme",
  "publishConfig": {
    "access": "public"
  }
}
